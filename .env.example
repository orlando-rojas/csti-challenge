# Canonical origin. The Vercel mirror must keep this value on the primary domain.
NEXT_PUBLIC_SITE_URL=https://csti-challenge.orlando-rojas.com

# Set to false on the Vercel mirror so it does not compete in search.
SITE_INDEXABLE=true

# While fakestoreapi.com is down, run `pnpm fakestore` and use the local stand-in.
# FAKESTORE_API_URL=http://localhost:4010
FAKESTORE_API_URL=https://fakestoreapi.com

# Required to call POST /api/revalidate. Leave empty to keep the route closed.
REVALIDATE_SECRET=

LOG_LEVEL=info

# Grafana Cloud OTLP. Leave empty to keep traces and metrics local no-ops.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
