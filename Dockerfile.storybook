FROM node:26-alpine AS build
RUN npm install -g corepack@0.31.0 && corepack enable && corepack prepare pnpm@10.15.1 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch --store-dir /pnpm/store \
  && pnpm install --offline --frozen-lockfile --store-dir /pnpm/store
COPY . .
# Git does not keep an empty public directory. Storybook staticDirs requires it.
RUN mkdir -p public
ENV HUSKY=0
RUN pnpm build-storybook

FROM nginx:1.31-alpine
COPY ops/storybook/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/storybook-static /usr/share/nginx/html
EXPOSE 80
